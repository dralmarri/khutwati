# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع ملف .env إلى GitHub.

# اسم النطاق الذي يشير إلى هذا الخادم (مثال: srv123456.hstgr.cloud أو phone.example.com)
GW_DOMAIN=

# --- بدالة باناسونيك (نفس إعدادات Bria) ---
# العنوان العام للمنزل (Out. Proxy في Bria) بدون المنفذ. يمكن أن يكون اسم DDNS.
PBX_PUBLIC_HOST=
PBX_PUBLIC_PORT=35767
# عنوان البدالة الداخلي (Domain في Bria)
PBX_LAN_IP=192.168.12.210
PBX_LAN_PORT=35767
# رقم التحويلة وكلمة مرورها في البدالة
PBX_EXT=300
PBX_PASSWORD=

# منفذ SIP الذي يستمع عليه الوسيط لاستقبال المكالمات من البدالة (UDP)
GW_SIP_PORT=35767
# مدة الرنين على الجوال بالثواني
RING_SECONDS=45

# --- التطبيق ---
# كلمة مرور طويلة عشوائية يدخلها التطبيق (أنشئها بالأمر: openssl rand -hex 24)
MOBILE_PASSWORD=

# --- إشعارات آيفون (APNs) ---
# ضع ملف المفتاح باسم secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.dralmarri.homephone

# --- إشعارات أندرويد (Firebase) ---
# ضع ملف حساب الخدمة باسم secrets/firebase.json (اتركه غير موجود إن لم تستخدم أندرويد)
